{
  "blocks": [
    "info",
    "financials",
    "quarterly_financials",
    "balance_sheet",
    "quarterly_balance_sheet",
    "history",
    "dividends"
  ],
  "concurrency": 1,
  "adaptive_cache": false,
  "cache_size": 100,
  "proactive_fetch_top_n": 50,
  "prefetch_schedule": {
    "info": "15 * * * *",
    "dividends": "0 0 */1 * *",
    "financials": "2 0 */1 * *",
    "balance_sheet": "4 0 */1 * *",
    "quarterly_financials": "6 0 */1 * *",
    "quarterly_balance_sheet": "8 0 */1 * *",
    "history": "10 0 */1 * *"
  },
  "ttl_seconds": {
    "info": 3600,
    "dividends": 86400,
    "financials": 86400,
    "balance_sheet": 86400,
    "quarterly_financials": 86400,
    "quarterly_balance_sheet": 86400,
    "history": 86400
  },
  "pending_ticker_window_seconds": 1,
  "seconds_sleep_when_rate_hit": 5,
  "rate_limiter": {
    "request_period_seconds": 120,
    "max_requests_per_period": 65,
    "cooldown_seconds": 80,
    "cooldown_fake_events": 10
  }
}
