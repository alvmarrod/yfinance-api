{
  "framework_name": "Equity Multi-Layer Analysis v1.0",
  "evaluation_order": [
    "quality",
    "financial_strength",
    "operational_trend",
    "valuation",
    "timing_optional"
  ],
  "layers": {
    "quality": {
      "description": "Structural business quality and value creation",
      "metrics": {
        "roic": {
          "green": { "min": 0.15 },
          "yellow": { "min": 0.10, "max": 0.15 },
          "red": { "max": 0.10 },
          "weight": 1.5,
          "critical": true
        },
        "revenue_cagr_5y": {
          "green": { "min": 0.10 },
          "yellow": { "min": 0.05, "max": 0.10 },
          "red": { "max": 0.05 },
          "weight": 1.0
        },
        "operating_margin": {
          "green": { "min": 0.15 },
          "yellow": { "min": 0.08, "max": 0.15 },
          "red": { "max": 0.08 },
          "weight": 1.0
        },
        "fcf_consistency_5y": {
          "green": { "min_positive_years": 4 },
          "yellow": { "min_positive_years": 3 },
          "red": { "min_positive_years": 0 },
          "weight": 1.2
        }
      },
      "pass_rules": {
        "min_green": 3,
        "or_condition": {
          "min_green": 2,
          "min_yellow": 2
        },
        "fail_if_critical_red": true
      },
      "missing_data_policy": {
        "allow_missing_metrics": 1,
        "if_roic_missing": {
          "require_roe_green": true,
          "tighten_debt_threshold_by": 0.05
        }
      }
    },
    "financial_strength": {
      "description": "Balance sheet and risk control",
      "metrics": {
        "net_debt_ebitda": {
          "green": { "max": 2.0 },
          "yellow": { "min": 2.0, "max": 3.5 },
          "red": { "min": 3.5 },
          "weight": 1.3,
          "critical": true
        },
        "interest_coverage": {
          "green": { "min": 8 },
          "yellow": { "min": 4, "max": 8 },
          "red": { "max": 4 },
          "weight": 1.2
        },
        "debt_to_equity": {
          "green": { "max": 0.8 },
          "yellow": { "min": 0.8, "max": 1.5 },
          "red": { "min": 1.5 },
          "weight": 1.0
        },
        "share_dilution_5y": {
          "green": { "max": 0.00 },
          "yellow": { "max": 0.05 },
          "red": { "min": 0.05 },
          "weight": 0.8
        }
      },
      "pass_rules": {
        "max_red": 0,
        "max_yellow": 1
      },
      "missing_data_policy": {
        "allow_missing_metrics": 1,
        "if_net_debt_ebitda_missing": {
          "require_debt_to_equity_green": true
        }
      }
    },
    "operational_trend": {
      "description": "Short-term business acceleration or deterioration",
      "optional_layer": true,
      "metrics": {
        "revenue_acceleration_3q": {
          "green": "accelerating",
          "yellow": "stable",
          "red": "decelerating"
        },
        "eps_revision_3m": {
          "green": "upward",
          "yellow": "neutral",
          "red": "downward"
        },
        "margin_trend": {
          "green": "expanding",
          "yellow": "stable",
          "red": "contracting"
        }
      },
      "pass_rules": {
        "min_green": 1,
        "fail_if_multiple_red": true
      },
      "missing_data_policy": {
        "allow_missing_metrics": 2
      }
    },
    "valuation": {
      "description": "Market pricing relative to fundamentals",
      "metrics": {
        "pe_vs_growth": {
          "green": { "max_ratio": 1.5 },
          "yellow": { "max_ratio": 2.0 },
          "red": { "min_ratio": 2.5 }
        },
        "peg": {
          "green": { "max": 1.5 },
          "yellow": { "max": 2.0 },
          "red": { "min": 2.0 }
        },
        "fcf_yield": {
          "green": { "min": 0.05 },
          "yellow": { "min": 0.03, "max": 0.05 },
          "red": { "max": 0.03 }
        },
        "ev_ebit": {
          "green": { "max": 18 },
          "yellow": { "max": 25 },
          "red": { "min": 25 }
        }
      },
      "pass_rules": {
        "min_green": 2
      },
      "missing_data_policy": {
        "allow_missing_metrics": 2,
        "if_peg_missing": {
          "increase_pe_strictness_by": 0.2
        }
      }
    },
    "timing_optional": {
      "description": "Technical optimization layer",
      "optional_layer": true,
      "metrics": {
        "price_vs_200dma": {
          "green": "above",
          "yellow": "near",
          "red": "below"
        },
        "rsi": {
          "green": { "max": 65 },
          "yellow": { "max": 75 },
          "red": { "min": 75 }
        }
      }
    }
  },
  "final_decision_logic": {
    "strong_candidate": {
      "required_layers_passed": [
        "quality",
        "financial_strength"
      ],
      "valuation_min_green": 2
    },
    "watchlist": {
      "quality_passed": true,
      "financial_strength_passed": true,
      "valuation_insufficient": true
    },
    "reject": {
      "fail_quality": true
    }
  }
}
